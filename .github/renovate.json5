{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],

  // 由 .github/workflows/renovate.yml 按计划执行（自托管，可用于私有仓库）。
  // 引擎版本跟随 renovatebot/github-action 的固定引用，不单独钉一个会过期的值。
  description: 'Renovate 配置：管理复用工作流里的 action 引用。',

  // 本仓库只有工作流，没有包清单；显式限定 manager 避免无谓的文件扫描。
  enabledManagers: ['github-actions'],

  labels: ['dependencies'],
  schedule: ['before 9am on monday'],
  timezone: 'Asia/Shanghai',
  forkProcessing: 'disabled',
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  rebaseWhen: 'behind-base-branch',

  // 自动合并不绑定某个具体 workflow：Renovate 默认要求 PR 上已有的状态检查全部
  // 通过，无需在分支保护里配 required check。反方向不成立——PR 上一条检查都没有
  // 时视为通过并直接合并，所以要保证仓库始终有对 PR 生效的检查作业。
  automerge: true,
  automergeType: 'branch',

  packageRules: [
    {
      description: 'major 升级只开 PR，不自动合并（大版本会换 runtime 与行为）',
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      description: 'patch、minor 与 pin 合并为一个 PR，检查通过后自动合并',
      matchUpdateTypes: ['patch', 'minor', 'pin'],
      groupName: 'actions 非 major 升级',
      automerge: true,
    },
  ],
}
