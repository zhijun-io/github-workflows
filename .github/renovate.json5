{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],

  // 由 .github/workflows/renovate.yml 按计划执行（自托管，可用于私有仓库）。
  // 引擎版本跟随 renovatebot/github-action 的固定引用，不单独钉一个会过期的值。
  description: 'Renovate 配置：管理复用工作流里的 action 引用。',

  // 本仓库只有工作流，没有包清单；显式限定 manager 避免无谓的文件扫描。
  enabledManagers: ['github-actions'],

  labels: ['dependencies'],
  schedule: ['before 9am on monday'],
  timezone: 'Asia/Shanghai',
  forkProcessing: 'disabled',
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  rebaseWhen: 'behind-base-branch',

  // 本仓库没有 CI，PR 上不会有任何状态检查，Renovate 因此视为通过并立即合并。
  // 自动合并只适用于 patch/minor/pin，破坏性变更都集中在 major。
  automerge: true,
  automergeType: 'branch',

  packageRules: [
    {
      description: 'major 升级只开 PR，不自动合并（大版本会换 runtime 与行为）',
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      description: 'patch、minor 与 pin 合并为一个 PR，检查通过后自动合并',
      matchUpdateTypes: ['patch', 'minor', 'pin'],
      groupName: 'actions 非 major 升级',
      automerge: true,
    },
  ],
}
